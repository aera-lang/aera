fn binary_search(arr: [int64], target: int64) -> int64 {
    var left = 0
    var right = arr.len()

    while left <= right {
        let mid = left + (right - left) / 2
        if arr[mid] == target {
            return mid
        }
        else if arr[mid] < target {
            left = mid + 1
        }
        else {
            right = mid - 1
        }
    }

    return -1 # target not found
}