struct Vector2 {
    x: float64 = 0.0
    y: float64 = 0.0
}

fn dot(v1: Vector2, v2: Vector2) -> float64 {
    v1.x * v2.x + v1.y * v2.y
}

fn cross(v1: Vector2, v2: Vector2) -> float64 {
    v1.x * v2.y + v1.y * v2.x
}

fn distance_squared(v1: Vector2, v2: Vector2) -> float64 {
    let dx = v1.x - v2.x
    let dy = v1.y - v2.y

    dx * dx + dy * dy
}